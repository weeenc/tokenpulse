APP_ENV=production
SERVER_PORT=8080
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=token_usage
MYSQL_USERNAME=tokenpulse
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password
JWT_SECRET=generate-at-least-32-random-bytes
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=720h
WEB_BASE_URL=https://tokenpulse.example.com
DEVICE_AUTH_EXPIRE=10m
CORS_ALLOWED_ORIGINS=https://tokenpulse.example.com
TRUSTED_PROXIES=172.16.0.0/12
MIGRATIONS_DIR=/app/migrations
